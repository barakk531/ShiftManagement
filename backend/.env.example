# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Database: either the DB_* values or one DATABASE_URL / MYSQL_URL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shift_management
# DATABASE_URL=mysql://user:password@host:3306/shift_management

# Auth: a long random string
JWT_SECRET=

# Email (verification codes and password reset)
RESEND_API_KEY=
EMAIL_FROM=

PORT=8080
CORS_ORIGIN=http://localhost:3000

# Development shortcuts
DEV_BYPASS_EMAIL_VERIFICATION=false
AVAILABILITY_WINDOW_ALWAYS_OPEN=false
